# ============================================================
# TELEGRAM BOT
# ============================================================

BOT_TOKEN=your_bot_token_here

API_ID=your_telegram_api_id_here

API_HASH=your_telegram_api_hash_here


# ============================================================
# MONGODB
# ============================================================

MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/database


# ============================================================
# ADMIN
# ============================================================

# Multiple Telegram IDs comma-separated
# Example:
# ADMIN_IDS=123456789,987654321

ADMIN_IDS=your_telegram_user_id_here


# ============================================================
# GITHUB
# ============================================================

GITHUB_TOKEN=your_github_personal_access_token

GITHUB_OWNER=your_github_username

GITHUB_REPO=your_github_repository

GITHUB_BRANCH=main


# ============================================================
# DATABASE CHANNEL
# ============================================================

# Channel ID where uploaded Test records will be posted

DATABASE_CHANNEL_ID=-1000000000000


# ============================================================
# PAYMENT VERIFICATION CHANNEL
# ============================================================

# Payment screenshots will be forwarded here

PAYMENT_VERIFY_CHANNEL_ID=-1000000000000


# ============================================================
# USER ACTIVITY CHANNEL
# ============================================================

# New users / start activity / important user activity

USER_ACTIVITY_CHANNEL_ID=-1000000000000


# ============================================================
# PAID USER CHANNEL
# ============================================================

# Paid user information / payment approval records

PAID_USER_CHANNEL_ID=-1000000000000


# ============================================================
# FORCE JOIN CHANNELS
# ============================================================

# Multiple channels separated by comma
#
# Example:
# FORCE_JOIN_CHANNELS=@channel1,@channel2

FORCE_JOIN_CHANNELS=


# ============================================================
# RENDER
# ============================================================

PORT=10000

PYTHONUNBUFFERED=1


# ============================================================
# OPTIONAL BOT SETTINGS
# ============================================================

# Maximum simultaneous workers
WORKER_COUNT=4

# Maximum queue size
MAX_QUEUE_SIZE=1000

# Maximum extraction requests per user
MAX_USER_QUEUE=3

# Free trial duration in days
FREE_TRIAL_DAYS=3

# Default test extraction price
TEST_PRICE=0


# ============================================================
# UPTIMEROBOT
# ============================================================

# UptimeRobot का API key यहाँ रखना आवश्यक नहीं है।
#
# UptimeRobot को Render के public URL पर बाहर से configure
# किया जाएगा।
#
# Example monitored URL:
#
# https://your-render-service.onrender.com/health
#
# इसलिए यहाँ UPTIMEROBOT_TOKEN की आवश्यकता नहीं है.
